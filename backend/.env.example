# Copy this file to .env and fill in your own values. Never commit the real .env file.

# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=*

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cafe_point

# ---- Auth ----
# Use a long random string in production (e.g. openssl rand -hex 48)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ---- Default admin (created/synced by `npm run seed`) ----
# Password rules: 8+ chars with at least one letter, one number, one special character.
# Extra admins can only be created from the admin dashboard (Customers tab).
ADMIN_NAME=Cafe Point Admin
ADMIN_EMAIL=admin@cafepoint.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password
ADMIN_PHONE=8459662016

# ---- Payment: UPI ----
UPI_ID=8459662016@upi
UPI_NUMBER=8459662016
