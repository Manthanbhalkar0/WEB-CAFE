# Copy this file to .env and fill in your own values. Never commit the real .env file.

# ---- Server ----
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=*

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cafe_point

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Default admin account (created automatically the first time you run `npm run seed`) ----
ADMIN_NAME=Cafe Point Admin
ADMIN_EMAIL=admin@cafepoint.com
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=8459662016

# ---- Payment: UPI (money is collected directly to this number's UPI ID - no gateway account needed) ----
# Most UPI apps let you find your UPI ID under Profile > UPI ID/VPA. Common patterns look like:
# 8459662016@ybl (PhonePe), 8459662016@paytm (Paytm), 8459662016@okaxis / @okhdfcbank (Google Pay), etc.
# Put YOUR real UPI ID here so payments actually reach you.
UPI_ID=8459662016@upi
UPI_NUMBER=8459662016
